# Server-only configuration. Never prefix these values with NEXT_PUBLIC_.
# Replace placeholders through the hosting platform's environment settings.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
ADMIN_PASSWORD="REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS"

# Explicit, isolated local demonstration (development only). No real database is used.
# Set to 1 only when testing. Fixtures live in memory and reset when the server restarts.
POPOL_VUH_DEMO=0
